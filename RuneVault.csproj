<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <AssemblyName>YggdrasilNetwork</AssemblyName>
    <RootNamespace>YggdrasilNetwork</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0</Version>
    <Product>Yggdrasil Network</Product>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <!-- Unity trae netstandard 2.1; el SDK de net462 trae 2.0. El conflicto es inofensivo. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <!-- Rutas de esta máquina. Si cambian, edita aquí o pásalas con -p:ValheimDir=... -->
  <PropertyGroup>
    <ValheimDir Condition="'$(ValheimDir)' == ''">E:\SteamLibrary\steamapps\common\Valheim</ValheimDir>
    <ProfileDir Condition="'$(ProfileDir)' == ''">$(APPDATA)\Thunderstore Mod Manager\DataFolder\Valheim\profiles\nibba</ProfileDir>
    <ManagedDir>$(ValheimDir)\valheim_Data\Managed</ManagedDir>
    <BepInExDir>$(ProfileDir)\BepInEx</BepInExDir>
    <DeployDir>$(BepInExDir)\plugins\YggdrasilNetwork</DeployDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- Permite compilar para .NET Framework 4.6.2 sin instalar el Developer Pack -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <!-- Íconos dentro del DLL: así se ven aunque el gestor de mods no copie la carpeta Assets. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\*.png" LogicalName="YggdrasilNetwork.Assets.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BepInEx"><HintPath>$(BepInExDir)\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(BepInExDir)\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Jotunn"><HintPath>$(BepInExDir)\plugins\ValheimModding-Jotunn\Jotunn.dll</HintPath><Private>false</Private></Reference>

    <Reference Include="assembly_valheim"><HintPath>$(ManagedDir)\assembly_valheim.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_utils"><HintPath>$(ManagedDir)\assembly_utils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_guiutils"><HintPath>$(ManagedDir)\assembly_guiutils.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(ManagedDir)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(ManagedDir)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(ManagedDir)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(ManagedDir)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(ManagedDir)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UIModule"><HintPath>$(ManagedDir)\UnityEngine.UIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(ManagedDir)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(ManagedDir)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- Copia el DLL al perfil de Thunderstore después de compilar -->
  <Target Name="DeployToProfile" AfterTargets="Build" Condition="Exists('$(BepInExDir)')">
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).dll" DestinationFolder="$(DeployDir)" />
    <Copy SourceFiles="$(TargetDir)$(AssemblyName).pdb" DestinationFolder="$(DeployDir)" Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
    <ItemGroup>
      <YggdrasilAssets Include="$(MSBuildProjectDirectory)\Assets\*.png" />
    </ItemGroup>
    <Copy SourceFiles="@(YggdrasilAssets)" DestinationFolder="$(DeployDir)\Assets" />
    <Message Importance="high" Text="Yggdrasil Network copiado a $(DeployDir)" />
  </Target>

  <!-- Paquete para Thunderstore: bin\Release\RuneVault-<versión>.zip -->
  <Target Name="ThunderstorePackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageDir>$(MSBuildProjectDirectory)\obj\thunderstore</PackageDir>
      <PackageZip>$(MSBuildProjectDirectory)\bin\Release\YggdrasilNetwork-$(Version).zip</PackageZip>
    </PropertyGroup>
    <ItemGroup>
      <PackageAssets Include="$(MSBuildProjectDirectory)\Assets\*.png" />
    </ItemGroup>
    <RemoveDir Directories="$(PackageDir)" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\Thunderstore\manifest.json;$(MSBuildProjectDirectory)\Thunderstore\icon.png;$(MSBuildProjectDirectory)\README.md;$(MSBuildProjectDirectory)\CHANGELOG.md;$(TargetDir)$(AssemblyName).dll"
          DestinationFolder="$(PackageDir)" />
    <Copy SourceFiles="@(PackageAssets)" DestinationFolder="$(PackageDir)\Assets" />
    <Delete Files="$(PackageZip)" />
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="$(PackageZip)" />
    <Message Importance="high" Text="Paquete de Thunderstore: $(PackageZip)" />
  </Target>

</Project>
